# Python
__pycache__/
*.py[cod]
*.pyo
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/
.env

# Editors / IDEs
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Coverage
.coverage
htmlcov/

# pip
pip-log.txt
pip-delete-this-directory.txt

# Raw data (keep README.md files for download instructions)
data/raw/**/*.mat
data/raw/**/*.csv
data/raw/**/*.xlsx
data/raw/**/*.h5
data/raw/**/*.hdf5
data/raw/**/*.zip
data/raw/**/*.parquet
data/raw/**/*.txt
# Upstream docs / example scripts that ship with some deposits (Kollmeyer
# 30T / HG2 PDFs, MATLAB live scripts, slide decks, download logs). Same
# policy as the rest of data/raw: download-on-demand, not committed.
data/raw/**/*.pdf
data/raw/**/*.mlx
data/raw/**/*.pptx
data/raw/**/*.log

# ORNL Leaf is the one bundled source — un-ignore its CSVs
!data/raw/ornl_leaf/*.csv

# Harmonized output is generated (examples/demo_end_to_end.py) and distributed
# via HuggingFace. The JSON metadata (cells/, tests/) IS tracked so the whole
# dataset is browsable on GitHub and the test suite runs without regenerating.
# The Parquet payload (timeseries ~4 GB + cycle_summary) stays on HuggingFace -
# every *.parquet is ignored repo-wide (see the rule further down). The generated
# HF dataset card (README.md, written by publish_to_huggingface.py at publish
# time) is not tracked either.
data/harmonized/timeseries/
data/harmonized/README.md

# Other derived data
data/params/
data/exports/
*.parquet

# Streamlit runtime secrets (keep config.toml)
.streamlit/secrets.toml
